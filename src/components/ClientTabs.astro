  connector: `<svg viewBox="0 0 220 120" width="220" height="120" fill="none"><rect x="8" y="24" width="66" height="72" rx="6" fill="#fcfaf5" stroke="#b5ada0" stroke-width="2"/><line x1="8" y1="36" x2="74" y2="36" stroke="#b5ada0" stroke-width="2"/><circle cx="15" cy="30" r="1.6" fill="#b5ada0"/><circle cx="21" cy="30" r="1.6" fill="#b5ada0"/><circle cx="27" cy="30" r="1.6" fill="#b5ada0"/><rect x="30" y="46" width="36" height="10" rx="5" fill="#ece7db"/><line x1="16" y1="68" x2="62" y2="68" stroke="#6bb82d" stroke-width="2" stroke-linecap="round"/><line x1="16" y1="78" x2="50" y2="78" stroke="#b5ada0" stroke-width="2" stroke-linecap="round"/><line x1="16" y1="87" x2="56" y2="87" stroke="#b5ada0" stroke-width="2" stroke-linecap="round"/><path d="M80 60 H90" stroke="#b5ada0" stroke-width="2" stroke-dasharray="2 4" stroke-linecap="round"/><circle cx="110" cy="60" r="17" fill="#d7f0a5" stroke="#4d9622" stroke-width="2.5"/><path d="M105 58 v-4 a5 5 0 0 1 10 0 v4" stroke="#3a741c" stroke-width="2.2" stroke-linecap="round"/><rect x="102" y="58" width="16" height="12" rx="2.5" fill="#4d9622"/><path d="M130 60 H142" stroke="#b5ada0" stroke-width="2" stroke-dasharray="2 4" stroke-linecap="round"/><rect x="148" y="12" width="60" height="96" rx="10" fill="#fcfaf5" stroke="#4d9622" stroke-width="2.5"/><line x1="170" y1="20" x2="186" y2="20" stroke="#b5ada0" stroke-width="2" stroke-linecap="round"/><rect x="156" y="30" width="44" height="30" rx="5" fill="#edf9ce" stroke="#b5e470" stroke-width="1.5"/><line x1="163" y1="40" x2="190" y2="40" stroke="#4d9622" stroke-width="2" stroke-linecap="round"/><line x1="163" y1="50" x2="182" y2="50" stroke="#8fd042" stroke-width="2" stroke-linecap="round"/><rect x="156" y="72" width="44" height="16" rx="8" fill="#6bb82d"/><path d="M171 80 l4 4 l8 -8" stroke="#fcfaf5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  // The app's chat with a balance widget and a transfer quote, flanked by a
