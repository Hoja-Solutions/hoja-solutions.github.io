---
import { getUi, type Lang } from "../i18n/ui";
import { clients, type Visual } from "../data/clients";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = getUi(lang);
const external = { target: "_blank", rel: "noopener noreferrer" };

// Wireframe drawings in the same palette as the Services illustrations. Lines
// stand in for text, so they read the same in both languages.
