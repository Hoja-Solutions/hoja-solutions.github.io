---
import Navbar from "./Navbar.astro";
import ProjectsOverview from "./ProjectsOverview.astro";
import Projects from "./Projects.astro";
import CTA from "./CTA.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  alt: string;
}
const { lang, alt } = Astro.props;
---

<div class="flex flex-col min-h-screen">
  <Navbar lang={lang} alt={alt} />
  <main class="flex-1">
    <ProjectsOverview lang={lang} page />
    <Projects lang={lang} />
    <CTA lang={lang} />
  </main>
  <Footer lang={lang} />
</div>
