---
import { getUi, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = getUi(lang);

// Grouped so the section reads as a stack rather than a wall of logos. The
// open-weight / hosted split states what the intro copy argues: we prefer
// models you can run yourself, and we build with whatever your team runs.
const groups = [
  {
    label: t.technologies.groups.openWeights,
    items: [
      { name: "Qwen", slug: "qwen" },
      { name: "Kimi", slug: "kimi" },
      { name: "DeepSeek", slug: "deepseek" },
      { name: "Z.ai", slug: "zdotai" },
      { name: "Mistral", slug: "mistralai" },
      { name: "Hugging Face", slug: "huggingface" },
    ],
  },
  {
    label: t.technologies.groups.hosted,
    items: [
      { name: "OpenAI", slug: "openai" },
      { name: "Anthropic", slug: "anthropic" },
      { name: "Gemini", slug: "googlegemini" },
      { name: "Grok", slug: "xai" },
      { name: "OpenRouter", slug: "openrouter" },
      { name: "Fireworks", slug: "fireworks" },
    ],
  },
  {
    label: t.technologies.groups.serving,
    items: [
      { name: "vLLM", slug: "vllm" },
      { name: "Ollama", slug: "ollama" },
      { name: "Ray", slug: "ray" },
      { name: "LangGraph", slug: "langgraph" },
      { name: "MLflow", slug: "mlflow" },
      { name: "W&B", slug: "weightsandbiases" },
    ],
  },
  {
    label: t.technologies.groups.data,
    items: [
      { name: "PostgreSQL", slug: "postgresql" },
      { name: "Qdrant", slug: "qdrant" },
      { name: "Redis", slug: "redis" },
      { name: "Databricks", slug: "databricks" },
      { name: "Spark", slug: "apachespark" },
      { name: "Airflow", slug: "apacheairflow" },
    ],
  },
  {
    label: t.technologies.groups.cloud,
    items: [
      { name: "AWS", slug: "aws" },
      { name: "Google Cloud", slug: "googlecloud" },
      { name: "Docker", slug: "docker" },
      { name: "Kubernetes", slug: "kubernetes" },
      { name: "Terraform", slug: "terraform" },
      { name: "GitHub Actions", slug: "githubactions" },
    ],
  },
];
---

<section id="technologies" class="bg-ivory pt-16 pb-20 sm:pt-20 sm:pb-24 lg:pt-24 lg:pb-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="max-w-2xl mb-12 sm:mb-16">
      <p class="text-xs font-medium text-brand-600 uppercase tracking-wider mb-3">{t.technologies.eyebrow}</p>
      <h2 class="text-2xl sm:text-3xl font-semibold text-surface-900 tracking-tight">
        {t.technologies.title}
      </h2>
      <p class="mt-4 text-base text-surface-600 leading-relaxed">
        {t.technologies.body}
      </p>
    </div>

    {/* One row per group on wide screens, label on the left, so the stack
        reads at a glance instead of taking a screen per group. */}
    <div class="divide-y divide-surface-200 border-y border-surface-200">
      {groups.map((group) => (
        <div class="grid grid-cols-1 lg:grid-cols-[13rem_1fr] items-center gap-3 lg:gap-8 py-5">
          <p class="text-xs font-medium text-surface-500 uppercase tracking-wider">{group.label}</p>
          {/* 6 items per group, and every column count divides 6, so a row is
              never left ragged at any breakpoint. */}
          <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-3">
            {group.items.map((tech) => (
              <li class="group flex items-center gap-2.5 min-w-0">
                <img
                  src={`/logos/${tech.slug}.svg`}
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                  class="w-5 h-5 shrink-0 object-contain grayscale opacity-70 transition duration-300 group-hover:grayscale-0 group-hover:opacity-100"
                />
                <span class="text-sm font-medium text-surface-800 truncate">{tech.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
